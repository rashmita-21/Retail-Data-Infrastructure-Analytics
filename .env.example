# Retail Data Infrastructure & Analytics Platform - Environment Configuration

# Environment mode: local | aws
PIPELINE_ENV=local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Local paths (relative to project root or absolute)
DATA_ROOT=data
WAREHOUSE_DB_PATH=data/warehouse/retail_warehouse.duckdb
CHECKPOINT_DB_PATH=data/state/pipeline_state.sqlite

# Spark configuration (local mode)
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_TIMEZONE=UTC

# Retry settings
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

# UCI Dataset URL
UCI_ONLINE_RETAIL_URL=https://archive.ics.uci.edu/static/public/352/online+retail.zip

# AWS Deployment Settings (used when deploying to AWS; do NOT commit real credentials)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
S3_RAW_BUCKET=retail-platform-raw-dev
S3_PROCESSED_BUCKET=retail-platform-processed-dev
S3_CURATED_BUCKET=retail-platform-curated-dev
S3_REJECTED_BUCKET=retail-platform-rejected-dev
GLUE_DATABASE_NAME=retail_analytics_catalog
REDSHIFT_WORKGROUP=retail-analytics-wg
REDSHIFT_DATABASE=retail_dw
REDSHIFT_IAM_ROLE_ARN=arn:aws:iam::000000000000:role/RetailRedshiftS3ReadRole
