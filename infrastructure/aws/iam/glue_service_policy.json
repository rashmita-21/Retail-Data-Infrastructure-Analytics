{
  "Version": "2012-10-12",
  "Statement": [
    {
      "Sid": "ReadRawAndProcessedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_RAW_BUCKET}",
        "arn:aws:s3:::${S3_RAW_BUCKET}/*",
        "arn:aws:s3:::${S3_PROCESSED_BUCKET}",
        "arn:aws:s3:::${S3_PROCESSED_BUCKET}/*"
      ]
    },
    {
      "Sid": "WriteProcessedRejectedCuratedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_PROCESSED_BUCKET}",
        "arn:aws:s3:::${S3_PROCESSED_BUCKET}/*",
        "arn:aws:s3:::${S3_REJECTED_BUCKET}",
        "arn:aws:s3:::${S3_REJECTED_BUCKET}/*",
        "arn:aws:s3:::${S3_CURATED_BUCKET}",
        "arn:aws:s3:::${S3_CURATED_BUCKET}/*"
      ]
    },
    {
      "Sid": "GlueCatalogScopedAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetTables",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:CreatePartition",
        "glue:BatchCreatePartition"
      ],
      "Resource": [
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:catalog",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:database/${GLUE_DATABASE_NAME}",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${GLUE_DATABASE_NAME}/*"
      ]
    },
    {
      "Sid": "CloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:/aws-glue/jobs/*"
    }
  ]
}
