{
  "Version": "2012-10-12",
  "Statement": [
    {
      "Sid": "RedshiftReadCuratedParquet",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_CURATED_BUCKET}",
        "arn:aws:s3:::${S3_CURATED_BUCKET}/transactions_partitioned/*"
      ]
    }
  ]
}
